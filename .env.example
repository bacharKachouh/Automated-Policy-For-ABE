# Automated-ABE Configuration
# -------------------------------------------------------
# Copy this file to .env and fill in your values.
# All variables are optional — sensible defaults are used.

# Override data / key / model base directories
# DATA_DIR=/absolute/path/to/data
# KEYS_DIR=/absolute/path/to/keys
# MODELS_DIR=/absolute/path/to/models

# Override trained model locations directly
# CLASSIFIER_MODEL_PATH=/path/to/security_classifier
# POLICY_MODEL_PATH=/path/to/policy_extractor

# Charm-Crypto pairing group (default: SS512)
# PAIRING_GROUP=SS512
